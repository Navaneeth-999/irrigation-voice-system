# ==============================================================================
# Voice-Driven Intelligent Irrigation Management System - Environment Variables
# Reference configuration template. Copy to .env in backend/ or frontend/ for dev.
# NEVER commit real credentials or .env files to Git.
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata
LOG_LEVEL=info

# Database (Supabase Managed PostgreSQL / Local PostgreSQL)
# For local dev without Postgres, leave DATABASE_URL blank to use embedded PGlite.
# In production, pooled string for app, direct string for migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Auth & Security
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
PUBLIC_FRONTEND_URL=http://localhost:5173
ADMIN_BOOTSTRAP_EMAIL=admin@csp-irrigation.org
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeAdmin123!

# Operational Modes
DEMO_MODE=true
ALLOW_DEMO_ENDPOINTS=true
COMMUNICATIONS_ENABLED=true
DRY_RUN=false

# Telephony & SMS
TELEPHONY_PROVIDER=mock
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEMO_LIVE_TEST_NUMBERS=
ALLOW_UNREVIEWED_PROMPTS=true
MAX_CONCURRENT_CALLS=3
MAX_CALLS_PER_DAY=200
MAX_SMS_PER_DAY=200
CALL_MAX_ATTEMPTS=3
CALL_RETRY_INTERVAL_MINUTES=120

# Weather Provider
WEATHER_PROVIDER=mock
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1
WEATHER_CACHE_TTL_MINUTES=180

# Scheduler
SCHEDULER_ENABLED=true

# Storage Provider (local | supabase)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET_AUDIO=audio-prompts
STORAGE_BUCKET_DOCUMENTS=seasonal-reports
STORAGE_BUCKET_VOICE_NOTES=voice-notes

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Optional AI / LLM (off by default)
LLM_PROVIDER=none
