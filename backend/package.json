{
  "name": "irrigation-voice-backend",
  "version": "1.0.0",
  "description": "Voice Driven Intelligent Irrigation Management and Seasonal Conservation Analytic System - Backend",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed:reference": "tsx src/scripts/seed-reference.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "demo:reset": "tsx src/scripts/demo-reset.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "twilio:spike": "tsx src/scripts/twilio-spike.ts",
    "test:locking": "tsx src/scripts/verify-postgres-locking.ts",
    "postinstall": "node scripts/patch-fontkit.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.16",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.19",
    "multer": "^2.5.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "twilio": "^5.4.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
